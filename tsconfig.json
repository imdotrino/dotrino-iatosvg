{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "src/**/*.d.mts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "src/vendor/fzstd.mjs", "web"]
}
